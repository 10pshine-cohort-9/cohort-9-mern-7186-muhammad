{
  "name": "notes-app-backend",
  "version": "1.0.0",
  "description": "Notes App - Node.js/Express/MySQL backend with JWT auth, Pino logging, and Mocha/Chai tests",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test mocha --recursive tests --timeout 10000 --exit",
    "test:coverage": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text mocha --recursive tests --timeout 10000 --exit",
    "db:sync": "node src/utils/syncDb.js",
    "sonar": "sonar-scanner"
  },
  "keywords": [
    "notes",
    "mern",
    "express",
    "mysql",
    "jwt",
    "pino"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "cross-env": "^7.0.3",
    "mocha": "^10.7.0",
    "nodemon": "^3.1.4",
    "nyc": "^17.0.0",
    "sinon": "^18.0.0",
    "sonarqube-scanner": "^5.0.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  }
}
